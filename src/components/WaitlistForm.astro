---
interface Props {
  dark?: boolean;
}
const { dark = false } = Astro.props;
---
<div class={`waitlist-form${dark ? ' waitlist-form--dark' : ''}`}>
  <a
    href="https://thelegitlaunch.kit.com/42cf1d5c10"
    class={`btn btn-primary btn-lg${dark ? ' btn-amber-on-dark' : ''}`}
    target="_blank"
    rel="noopener noreferrer"
  >Get the Free POD Legal Checklist</a>
  <p class="waitlist-form__note">
    Free download. Unsubscribe anytime.
  </p>
</div>

<style>
.waitlist-form { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-3); }
.waitlist-form--dark .waitlist-form__note { color: rgba(255,255,255,0.6); }
.waitlist-form__note {
  font-size: var(--text-body-sm);
  color: var(--muted);
  margin: 0;
}
</style>
