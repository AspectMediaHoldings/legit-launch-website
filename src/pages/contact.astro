---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Contact"
  description="Questions about The Legit Launch? Contact Nathan Spells or reach out at hello@thelegitlaunch.com."
>

  <section class="contact-hero">
    <div class="container-narrow">
      <p class="eyebrow">Get in touch</p>
      <h1>Contact</h1>
      <p class="lead">Questions about the course or enrollment? Fill out the form below or email directly. Expect a reply within 48 business hours.</p>
    </div>
  </section>

  <section class="contact-body">
    <div class="container-narrow">
      <div class="contact-grid">

        <div class="contact-form-wrap">
          <!-- Netlify detects this form at build time via data-netlify="true" -->
          <form
            name="contact"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            action="/contact-success"
            class="contact-form"
          >
            <input type="hidden" name="form-name" value="contact">

            <!-- Honeypot — hidden from humans, catches bots -->
            <p class="field-hidden" aria-hidden="true">
              <label>Do not fill this out: <input name="bot-field" tabindex="-1" autocomplete="off"></label>
            </p>

            <div class="field-group">
              <label for="name">Name <span class="required">*</span></label>
              <input type="text" id="name" name="name" required autocomplete="name" placeholder="Your name">
            </div>

            <div class="field-group">
              <label for="email">Email <span class="required">*</span></label>
              <input type="email" id="email" name="email" required autocomplete="email" placeholder="you@example.com">
            </div>

            <div class="field-group">
              <label for="subject">Subject</label>
              <select id="subject" name="subject">
                <option value="">Select a topic (optional)</option>
                <option value="course-question">Question about the course</option>
                <option value="enrollment">Enrollment</option>
                <option value="other">Something else</option>
              </select>
            </div>

            <div class="field-group">
              <label for="message">Message <span class="required">*</span></label>
              <textarea id="message" name="message" required rows="6" placeholder="What would you like to know?"></textarea>
            </div>

            <button type="submit" class="btn btn-primary btn-lg">Send Message</button>
          </form>
        </div>

        <div class="contact-aside">
          <div class="contact-direct">
            <h3>Prefer email?</h3>
            <p>
              <a href="mailto:hello@thelegitlaunch.com">hello@thelegitlaunch.com</a>
            </p>
          </div>
          <div class="contact-waitlist">
            <h3>Ready to enroll?</h3>
            <p>The course is open now at the early-bird price of $97. Or grab the free POD Legal Checklist to get started.</p>
            <a href="https://payhip.com/order?link=r5xdu&pricing_plan=ANzp05RKzX" class="btn btn-primary" target="_blank" rel="noopener noreferrer">Enroll Now — $97</a>
            <a href="https://thelegitlaunch.kit.com/42cf1d5c10" class="btn btn-secondary" target="_blank" rel="noopener noreferrer" style="margin-top: var(--space-2);">Get the Free Checklist</a>
          </div>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>

<style>
.contact-hero {
  padding: var(--space-9) 0 var(--space-6);
  background: var(--surface);
  border-bottom: var(--hairline) solid var(--border);
}
.contact-hero h1 { margin-bottom: var(--space-3); }

.contact-body { padding: var(--space-8) 0 var(--space-9); }

.contact-grid {
  display: grid;
  grid-template-columns: 1fr 280px;
  gap: var(--space-8);
  align-items: start;
}

/* Form */
.contact-form { display: flex; flex-direction: column; gap: var(--space-5); }

.field-hidden { display: none; }

.field-group { display: flex; flex-direction: column; gap: var(--space-2); }

.field-group label {
  font-size: var(--text-body-sm);
  font-weight: 700;
  color: var(--fg);
}
.required { color: var(--amber); }

.field-group input,
.field-group select,
.field-group textarea {
  font-family: var(--font-body);
  font-size: var(--text-body);
  color: var(--fg);
  background: var(--white);
  border: var(--hairline) solid var(--border-strong);
  border-radius: var(--radius);
  padding: var(--space-3) var(--space-4);
  transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  width: 100%;
}
.field-group input:focus,
.field-group select:focus,
.field-group textarea:focus {
  outline: none;
  border-color: var(--navy);
  box-shadow: 0 0 0 3px rgba(26,48,96,0.12);
}
.field-group input::placeholder,
.field-group textarea::placeholder { color: var(--muted-2); }

.field-group textarea { resize: vertical; min-height: 140px; }

.field-group select { cursor: pointer; }

/* Aside */
.contact-aside { display: flex; flex-direction: column; gap: var(--space-6); }
.contact-direct,
.contact-waitlist {
  background: var(--surface-alt);
  border: var(--hairline) solid var(--border);
  border-radius: var(--radius);
  padding: var(--space-5);
}
.contact-direct h3,
.contact-waitlist h3 {
  font-family: var(--font-body);
  font-size: var(--text-body-sm);
  font-weight: 700;
  color: var(--navy);
  letter-spacing: var(--tracking-eyebrow);
  text-transform: uppercase;
  margin: 0 0 var(--space-3);
}
.contact-direct p,
.contact-waitlist p {
  font-size: var(--text-body-sm);
  color: var(--fg-2);
  margin: 0 0 var(--space-4);
  line-height: var(--lh-normal);
}
.contact-direct p:last-child,
.contact-waitlist p:last-child { margin-bottom: 0; }
.contact-direct a {
  font-weight: 700;
  color: var(--navy);
  word-break: break-all;
}

@media (max-width: 768px) {
  .contact-grid { grid-template-columns: 1fr; }
  .contact-aside { order: -1; }
}
</style>
